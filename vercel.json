{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run deploy:check-env && npm run build",
  "functions": {
    "app/api/**/route.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  }
}
